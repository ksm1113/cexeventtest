{
  "version": 2,
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/events", "dest": "/api/events.py" },
    { "src": "/api/summary", "dest": "/api/summary.py" },
    { "src": "/", "dest": "/index.html" }
  ]
}
